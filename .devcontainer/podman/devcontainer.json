{
  "name": "AAP-CasC-Demo-podman",
  // "image": "ghcr.io/ansible/community-ansible-dev-tools:latest",
  // "image": "localhost/aap-24-dev-ee:dev",
  "image": "quay.io/branic/aap-24-development-ee:latest",
  "containerUser": "root",
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_RESOURCE",
    "--device",
    "/dev/fuse",
    "--security-opt",
    "seccomp=unconfined",
    "--security-opt",
    "label=disable",
    "--security-opt",
    "apparmor=unconfined",
    "--userns=host",
    "--hostname=aap-config-demo-container",
    "--volume",
    "ansible-dev-tools-container-storage:/var/lib/containers",
    "--net",
    "host"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["redhat.ansible", "redhat.vscode-redhat-account"]
    }
  }
}
